# Copy to .env for Docker Compose. Never commit .env.
MYSQL_ROOT_PASSWORD=local-root-change-me
MYSQL_DATABASE=persona_dev
MYSQL_USER=persona_dev
MYSQL_PASSWORD=local-dev-change-me
MYSQL_PORT=3308
# Spring Boot does not automatically read the root .env; export these in its process.
DB_URL=jdbc:mysql://127.0.0.1:3308/persona_dev?connectionTimeZone=UTC&characterEncoding=UTF-8
DB_USER=persona_dev
DB_PASSWORD=local-dev-change-me
DEV_OWNER_ID=dev-user-local
DEV_API_ENABLED=true
SERVER_PORT=8080
