  "logicalTargetMappings": {
    "unsolicitedAdvice": {
      "storedAt": "contextualPolicies[].instruction",
      "disabledMeaning": "在用户没有明确请求解决方案时，优先倾听、回应情绪；不主动说教或罗列建议。",
      "enabledMeaning": "仅在当前情境规则明确表达用户欢迎主动协助时，先回应情绪，再提供具体方案；如果用户要求只倾诉或暂停，应尊重其当前要求。",
      "note": "这是映射层的逻辑目标，沿用 affectedTargets 中的逻辑名称；它不是画像 JSON 的独立字段，也不是 JSON Pointer。"
    },
    "userAutonomy": {
      "storedAt": "contextualPolicies[].instruction 与必要的 hardConstraints",
      "meaning": "任何主导性偏好都不能覆盖用户明确拒绝、身体边界或重大决定的自主权。"
    }
